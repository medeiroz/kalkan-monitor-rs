// Kalkan Monitor — sidebar shell + 3 screens (light theme).
// Redesigned from UI/UX critique. New UI, different from the original software.

// ---------------------------------------------------------------- tokens
global Palette {
    out property <color> bg:          #eef1f7;
    out property <color> surface:     #ffffff;
    out property <color> surface-2:   #f6f8fc;
    out property <color> hover:       #e9edf5;   // hover tint on surface-2 (sidebar)
    out property <color> accent-weak-hover: #dbe6fd;   // hover on a selected item
    out property <color> line:        #e4e8f0;
    out property <color> line-strong: #d2d9e6;

    out property <color> ink:         #1b2330;
    out property <color> muted:       #5f6b80;   // AA on white
    out property <color> faint:       #8a93a6;

    out property <color> accent:      #2f6df6;
    out property <color> accent-weak: #e7eefe;
    out property <color> warm:        #ff7a59;
    out property <color> teal:        #16b8a6;

    out property <color> ok:          #16a34a;
    out property <color> ok-weak:     #e8f9ee;
    out property <color> warn:        #d97706;
    out property <color> warn-weak:   #fdf3e2;
    out property <color> danger:      #dc2626;
    out property <color> danger-weak: #fdecec;
    out property <color> off:         #cbd3e0;

    // cooler's little screen (represents the hardware; exception to the light theme)
    out property <color> lcd-bg:      #0e1726;
    out property <color> lcd-ink:     #eaf2ff;
    out property <color> lcd-dim:     #5b6b85;
}

enum ConnState { disconnected, connecting, connected, error }

// ---------------------------------------------------------------- nav item
component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 42px;
    border-radius: 10px;
    background: selected ? (touch.has-hover ? Palette.accent-weak-hover : Palette.accent-weak)
              : touch.has-hover ? Palette.hover : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        alignment: start;
        // side selection marker (wrapper centers it vertically)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 3px;
                height: 18px;
                border-radius: 2px;
                background: root.selected ? Palette.accent : transparent;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.selected ? Palette.accent : touch.has-hover ? #000000 : Palette.ink;
            animate color { duration: 120ms; }
            font-size: 14px;
            font-weight: root.selected ? 700 : 500;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------- status pill
component StatusPill inherits Rectangle {
    in property <ConnState> state;
    property <string> label:
        state == ConnState.connected ? "Connected"
        : state == ConnState.connecting ? "Connecting…"
        : state == ConnState.error ? "Connection error"
        : "Disconnected";
    property <color> tone:
        state == ConnState.connected ? Palette.ok
        : state == ConnState.connecting ? Palette.warn
        : state == ConnState.error ? Palette.danger
        : Palette.danger;
    property <color> tone-weak:
        state == ConnState.connected ? Palette.ok-weak
        : state == ConnState.connecting ? Palette.warn-weak
        : Palette.danger-weak;

    height: 34px;
    border-radius: 17px;
    background: tone-weak;
    border-width: 1px;
    border-color: tone.with-alpha(0.35);

    HorizontalLayout {
        spacing: 8px;
        padding-left: 13px;
        padding-right: 15px;
        VerticalLayout {
            alignment: center;
            // connected = filled dot; others = hollow ring (shape + color)
            Rectangle {
                width: 11px; height: 11px; border-radius: 6px;
                background: root.state == ConnState.connected ? root.tone : transparent;
                border-width: 2px;
                border-color: root.tone;
                opacity: root.state == ConnState.connecting ? 0.5 : 1.0;
                animate opacity { duration: 1000ms; iteration-count: -1; direction: alternate; }
            }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            color: Palette.ink;
            font-size: 13px;
            font-weight: 700;
            overflow: elide;
        }
    }
}

// ---------------------------------------------------------------- gauge bar
component GaugeBar inherits Rectangle {
    in property <float> fraction;   // 0..1
    in property <int> level;        // 0 normal / 1 warn / 2 crit
    in property <color> tint;
    height: 10px;
    background: Palette.line;
    border-radius: 5px;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.fraction, 0.0, 1.0);
        height: parent.height;
        border-radius: 5px;
        background: root.level == 2 ? Palette.danger
                  : root.level == 1 ? Palette.warn
                  : root.tint;
        animate width { duration: 400ms; easing: ease-out; }
    }
}

// ---------------------------------------------------------------- stat card
component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <string> state-label;
    in property <float> fraction;
    in property <int> level;
    in property <color> tint;

    min-width: 170px;
    horizontal-stretch: 1;
    background: Palette.surface;
    border-radius: 18px;
    border-width: 1px;
    border-color: Palette.line;

    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        alignment: start;
        Text {
            text: root.label;
            color: Palette.muted;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.4px;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.value;
                color: Palette.ink;
                font-size: 34px;
                font-weight: 800;
            }
            Text {
                text: root.unit;
                color: Palette.muted;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        GaugeBar { fraction: root.fraction; level: root.level; tint: root.tint; }
        Text {
            text: root.state-label;
            color: root.level == 2 ? Palette.danger
                 : root.level == 1 ? Palette.warn
                 : Palette.faint;
            font-size: 12px;
            font-weight: 600;
            wrap: word-wrap;
        }
    }
}

// ---------------------------------------------------------------- LCD preview
component DisplayPreview inherits Rectangle {
    in property <string> temp;
    // Not shown: neither model displays the usage. Kept so the callers (and the
    // Rust side) don't change.
    in property <string> load;
    // Shown as RPM on Delta V2 only.
    in property <string> fan;
    // 0 = Alpha (temperature only), 1 = Delta V2 (temperature + fan speed)
    in property <int> model: 0;
    in property <int> frame-index;
    in property <bool> sending;

    // Round screen: square, capped at 240px and centered in the column.
    property <length> dia: min(root.width, 240px);
    height: root.dia + 28px;
    // Temperature digits' font sizes; the "°C" is exactly half of them (as on
    // the real cooler), in every size.
    property <length> alpha-temp-size: root.dia * 0.34;
    property <length> delta-temp-size: root.dia * 0.3;

    Rectangle {
        y: 0px;
        width: root.dia;
        height: root.dia;
        x: (root.width - root.dia) / 2;
        background: Palette.lcd-bg;
        border-radius: root.dia / 2;
        border-width: 3px;
        border-color: Palette.teal;

        // Delta V2: temperature on top, fan speed below, small logo top-left.
        if root.model == 1 : Rectangle {
            Text {
                x: root.dia * 0.2; y: root.dia * 0.17;
                text: "KALKAN";
                color: white;
                font-size: root.dia * 0.05;
                font-weight: 800;
                letter-spacing: root.dia * 0.008;
            }
            VerticalLayout {
                alignment: center;
                spacing: root.dia * 0.06;
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.temp == "" ? "--" : root.temp;
                        color: white;
                        font-size: root.delta-temp-size;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: start;
                        padding-top: root.dia * 0.04;
                        Text { text: "°C"; color: white; font-size: root.delta-temp-size / 2; font-weight: 700; }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.fan == "" ? "--" : root.fan;
                        color: white;
                        font-size: root.dia * 0.15;
                        font-weight: 700;
                        font-family: "Consolas";
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: root.dia * 0.02;
                        Text { text: "RPM"; color: white; font-size: root.dia * 0.07; font-weight: 700; }
                    }
                }
            }
        }
        // Alpha: temperature only.
        if root.model == 0 : VerticalLayout {
            alignment: center;
            spacing: root.dia * 0.04;
            // seven-segment-ish digits with a small °C at the top right
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: root.temp == "" ? "--" : root.temp;
                    color: white;
                    font-size: root.alpha-temp-size;
                    font-weight: 800;
                    font-family: "Consolas";
                    letter-spacing: root.dia * 0.012;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: start;
                    padding-top: root.dia * 0.04;
                    Text { text: "°C"; color: white; font-size: root.alpha-temp-size / 2; font-weight: 700; }
                }
            }
            Text {
                text: "KALKAN";
                color: white;
                font-size: root.dia * 0.075;
                font-weight: 800;
                letter-spacing: root.dia * 0.02;
                horizontal-alignment: center;
            }
        }
    }

    Text {
        y: root.dia + 8px;
        width: root.width;
        text: root.sending ? "● Sending" : "○ Offline preview";
        color: root.sending ? Palette.teal : Palette.faint;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
    }
}

// ---------------------------------------------------------------- model toggle
// Two-option segmented control (cooler model of the preview).
component ModelToggle inherits Rectangle {
    in property <int> current: 0;
    callback picked(int);
    height: 36px;
    border-radius: 18px;
    background: Palette.surface-2;
    border-width: 1px;
    border-color: Palette.line-strong;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for label[i] in ["Alpha", "Delta V2"] : Rectangle {
            horizontal-stretch: 1;
            border-radius: 15px;
            background: root.current == i ? (t.has-hover ? Palette.accent-weak-hover : Palette.accent-weak)
                      : t.has-hover ? Palette.hover : transparent;
            animate background { duration: 120ms; }
            Text {
                text: label;
                color: root.current == i ? Palette.accent : Palette.ink;
                font-size: 13px;
                font-weight: root.current == i ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            t := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}

// ---------------------------------------------------------------- select
// One entry of a select: two text lines, the live value on the right and an
// optional group header (shown above the first entry of each group).
export struct SourceItem {
    primary: string,
    secondary: string,
    group: string,
    value: string,
    header: bool,
}

component Select inherits Rectangle {
    in property <[SourceItem]> model;
    in-out property <int> current-index: 0;
    callback changed(int);

    height: 52px;
    border-radius: 10px;
    background: touch.has-hover ? Palette.surface-2 : Palette.surface;
    border-width: 1px;
    border-color: Palette.line-strong;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.current-index >= 0 ? root.model[root.current-index].primary : "";
                color: Palette.ink;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            if root.current-index >= 0 && root.model[root.current-index].secondary != "" : Text {
                text: root.model[root.current-index].secondary;
                color: Palette.muted;
                font-size: 12px;
                font-weight: 500;
                overflow: elide;
            }
        }
        Text {
            text: root.current-index >= 0 ? root.model[root.current-index].value : "";
            color: Palette.accent;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 12px;
                height: 8px;
                stroke: Palette.muted;
                stroke-width: 1.6px;
                commands: "M 0 0 L 6 5 L 12 0";
            }
        }
    }

    touch := TouchArea { clicked => { popup.show(); } }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 4px;
        width: max(root.width, 400px);
        height: min(list.preferred-height + 12px, 360px);
        Rectangle {
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.line-strong;
            Flickable {
                list := VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for item[idx] in root.model : VerticalLayout {
                        if item.header : Text {
                            text: item.group;
                            color: Palette.faint;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0.4px;
                            height: 26px;
                            vertical-alignment: bottom;
                            horizontal-alignment: left;
                        }
                        Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: opt.has-hover ? Palette.accent-weak
                                      : idx == root.current-index ? Palette.surface-2 : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: item.primary;
                                        color: idx == root.current-index ? Palette.accent : Palette.ink;
                                        font-size: 14px;
                                        font-weight: idx == root.current-index ? 700 : 500;
                                        overflow: elide;
                                    }
                                    if item.secondary != "" : Text {
                                        text: item.secondary;
                                        color: Palette.muted;
                                        font-size: 12px;
                                        font-weight: 500;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: item.value;
                                    color: Palette.muted;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            opt := TouchArea {
                                clicked => {
                                    root.current-index = idx;
                                    root.changed(idx);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- slot editor
component SlotEditor inherits VerticalLayout {
    in property <string> label;
    in property <[SourceItem]> sources;
    in-out property <int> current-index;
    in property <string> sends;        // "Sends: 52 (0–255)"
    in property <bool> warn;
    callback changed(int);

    spacing: 8px;
    Text {
        text: root.label;
        color: Palette.muted;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.4px;
        overflow: elide;
    }
    Select {
        model: root.sources;
        current-index <=> root.current-index;
        changed(i) => { root.changed(i); }
    }
    Text {
        text: root.sends;
        color: root.warn ? Palette.warn : Palette.faint;
        font-size: 12px;
        font-weight: 600;
        wrap: word-wrap;
    }
}

// ---------------------------------------------------------------- toggle switch
// Shown on Windows when the app runs without administrator rights.
component ElevationWarning inherits Rectangle {
    min-height: 52px;
    background: Palette.warn-weak;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.warn.with-alpha(0.4);
    VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        Text {
            text: "Running without administrator rights — some sensors and the autostart task may be unavailable. Restart the app and accept the prompt.";
            color: Palette.warn; font-size: 13px; font-weight: 600; vertical-alignment: center; wrap: word-wrap;
        }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: checked ? Palette.accent : Palette.off;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ---------------------------------------------------------------- window
export component AppWindow inherits Window {
    title: "Kalkan Monitor";
    preferred-width: 980px;
    preferred-height: 600px;
    // Compact layout (narrow window): stat cards and the display preview stack
    // vertically, the sidebar shrinks, and the page scrolls vertically.
    // Wide layout needs 200 (sidebar) + 2x24 (padding) + 3x170 (cards) + 2x18 = 794px.
    min-width: 520px;
    min-height: 420px;
    // Cap = 200 (sidebar) + 2x24 (padding) + 1100 (content cap): at max width the
    // content fills the window with no extra side margins.
    max-width: 1348px;
    background: Palette.bg;
    property <bool> compact: root.width < 800px;
    property <length> side-w: root.compact ? 160px : 200px;

    // navigation
    in-out property <int> active-page: 1;   // 0 dashboard, 1 display (initial page), 2 device, 3 settings

    // ---- dashboard ----
    in property <float> cpu-load: 0;
    in property <string> cpu-load-str: "0";
    in property <int> cpu-level: 0;
    in property <string> cpu-state: "Normal";

    in property <string> cpu-temp-str: "--";
    in property <float> temp-fraction: 0;
    in property <int> temp-level: 0;
    in property <string> temp-state: "No reading";

    in property <string> fan-str: "--";
    in property <float> fan-fraction: 0;
    in property <int> fan-level: 0;
    in property <string> fan-state: "No sensor on this platform";

    // ---- connection ----
    in property <ConnState> conn-state: ConnState.disconnected;
    in property <string> device-label: "No device";
    in property <string> device-detail: "";
    // Firmware of the detected display (empty = none detected).
    in property <string> firmware-label: "";   // "Firmware 1.3 · USB serial · COM5 · 1f3a:0008"
    in property <string> firmware-hint: "";    // friendly model text
    in property <string> firmware-short: "";   // "Firmware 1.3"
    in property <string> hid-error: "";
    // Windows only: the UAC prompt was declined, so the app runs degraded.
    in property <bool> not-elevated: false;

    // ---- display config ----
    in property <[SourceItem]> temp-sources;
    in property <[SourceItem]> fan-sources;
    in property <[SourceItem]> load-sources;
    in-out property <int> temp-source-index: 0;
    in-out property <int> fan-source-index: 0;
    in-out property <int> load-source-index: 0;
    in property <string> temp-sends: "";
    in property <string> fan-sends: "";
    in property <string> load-sends: "";
    in property <bool> temp-sends-warn: false;
    in property <bool> fan-sends-warn: false;
    in property <bool> load-sends-warn: false;
    callback slot-changed(int, int);   // (slot, index)

    // ---- preview ----
    in property <string> prev-temp: "--";
    in property <string> prev-load: "--";
    in property <string> prev-fan: "--";
    in property <int> prev-frame-index: 0;
    in property <bool> prev-sending: false;
    // Cooler model the preview mimics: 0 = Alpha, 1 = Delta V2 (user's choice).
    in-out property <int> model-index: 0;
    callback model-changed(int);

    // ---- preferences ----
    in-out property <bool> autostart: false;
    in property <string> autostart-error: "";
    callback autostart-toggled(bool);

    // The layout is sized explicitly (not through the window's layout info) so
    // that `compact`, which depends on the window width, creates no binding loop.
    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        // ============ sidebar ============
        Rectangle {
            width: root.side-w;
            background: Palette.surface-2;
            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: root.compact ? 14px : 18px;
                spacing: 6px;
                VerticalLayout {
                    padding-bottom: 14px;
                    spacing: 2px;
                    Text { text: "KALKAN"; color: Palette.ink; font-size: 18px; font-weight: 800; letter-spacing: 1px; }
                    Text { text: "Monitor"; color: Palette.faint; font-size: 13px; font-weight: 600; }
                }
                NavItem { text: "Display";     selected: root.active-page == 1; clicked => { root.active-page = 1; } }
                NavItem { text: "Dashboard";      selected: root.active-page == 0; clicked => { root.active-page = 0; } }
                NavItem { text: "Device"; selected: root.active-page == 2; clicked => { root.active-page = 2; } }
                NavItem { text: "Settings"; selected: root.active-page == 3; clicked => { root.active-page = 3; } }

                Rectangle { vertical-stretch: 1; }

                Rectangle { height: 1px; background: Palette.line; }
                Rectangle {
                    height: (root.conn-state == ConnState.connected && root.firmware-short != "") ? 68px : 48px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: start;
                            StatusPill { state: root.conn-state; }
                        }
                        if root.conn-state == ConnState.connected && root.firmware-short != "" : Text {
                            text: root.firmware-short;
                            color: Palette.faint; font-size: 11px; font-weight: 600;
                            overflow: elide;
                        }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.active-page = 2; } }
                }
            }
        }

        // ============ content ============
        Rectangle {
            background: Palette.bg;
            scroller := Flickable {
                content-width: self.width;
                content-height: max(self.height, page.preferred-height);
                page := VerticalLayout {
                // page content is capped at 1100px and centered on wide windows
                x: 0;
                y: 0;
                width: scroller.content-width;
                height: scroller.content-height;
                padding-top: 24px;
                padding-bottom: 24px;
                padding-left: root.compact ? 16px : max(24px, (root.width - root.side-w - 1100px) / 2);
                padding-right: root.compact ? 16px : max(24px, (root.width - root.side-w - 1100px) / 2);
                spacing: 20px;

                // ---- header ----
                HorizontalLayout {
                    alignment: space-between;
                    spacing: 12px;
                    Text {
                        overflow: elide;
                        text: root.active-page == 0 ? "Dashboard"
                            : root.active-page == 1 ? "Cooler display"
                            : root.active-page == 2 ? "Device"
                            : "Settings";
                        color: Palette.ink;
                        font-size: 22px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "● Live · every 1 s";
                        color: Palette.teal;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // ============ DASHBOARD ============
                if root.active-page == 0 : VerticalLayout {
                    spacing: 18px;
                    GridLayout {
                        spacing: 18px;
                        vertical-stretch: 0;
                        StatCard {
                            row: root.compact ? 0 : 0; col: 0;
                            label: "CPU USAGE"; value: root.cpu-load-str; unit: "%";
                            fraction: root.cpu-load / 100; level: root.cpu-level;
                            state-label: root.cpu-state; tint: Palette.accent;
                        }
                        StatCard {
                            row: root.compact ? 1 : 0; col: root.compact ? 0 : 1;
                            label: "TEMPERATURE"; value: root.cpu-temp-str; unit: "°C";
                            fraction: root.temp-fraction; level: root.temp-level;
                            state-label: root.temp-state; tint: Palette.warm;
                        }
                        StatCard {
                            row: root.compact ? 2 : 0; col: root.compact ? 0 : 2;
                            label: "FAN / PUMP"; value: root.fan-str; unit: "RPM";
                            fraction: root.fan-fraction; level: root.fan-level;
                            state-label: root.fan-state; tint: Palette.teal;
                        }
                    }
                    // mirror of what goes to the display + shortcut
                    Rectangle {
                        height: 64px;
                        background: Palette.surface;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Palette.line;
                        HorizontalLayout {
                            padding-left: 20px; padding-right: 16px; spacing: 10px;
                            alignment: space-between;
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                Text { text: "On display:"; color: Palette.muted; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                Text {
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    text: root.prev-temp + "°C · " + root.prev-fan + " RPM · " + root.prev-load + "%";
                                    color: Palette.ink; font-size: 13px; font-weight: 700; vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: edit-txt.preferred-width + 28px;
                                    height: 34px;
                                    border-radius: 10px;
                                    background: edit-touch.has-hover ? Palette.accent : Palette.accent-weak;
                                    animate background { duration: 120ms; }
                                    edit-txt := Text {
                                        text: "Configure";
                                        color: edit-touch.has-hover ? #ffffff : Palette.accent;
                                        font-size: 13px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    edit-touch := TouchArea { clicked => { root.active-page = 1; } }
                                }
                            }
                        }
                    }
                    // "no hardware" banner
                    if root.conn-state != ConnState.connected : Rectangle {
                        min-height: 44px;
                        background: Palette.warn-weak;
                        border-radius: 12px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            Text {
                                text: "Running without a cooler — the sensors are the PC's; nothing is being sent to the display.";
                                color: Palette.warn; font-size: 13px; font-weight: 600; vertical-alignment: center; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // ============ DISPLAY ============
                if root.active-page == 1 : VerticalLayout {
                    spacing: 16px;
                    if root.conn-state != ConnState.connected : Rectangle {
                        min-height: 44px;
                        background: Palette.warn-weak;
                        border-radius: 12px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            Text {
                                text: "No cooler connected — nothing is being sent to the display.";
                                color: Palette.warn; font-size: 13px; font-weight: 600; vertical-alignment: center; wrap: word-wrap;
                            }
                        }
                    }
                    GridLayout {
                    vertical-stretch: 1;
                    spacing: 20px;
                    // left: the 3 slots
                    Rectangle {
                        row: 0; col: 0;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        background: Palette.surface;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 18px;
                            Text {
                                text: "Choose the source for each field sent to the cooler. Alpha models (240, 360, 360-W) show only the temperature; the other fields are still sent to the device.";
                                color: Palette.muted; font-size: 13px; font-weight: 500; wrap: word-wrap;
                            }
                            SlotEditor {
                                label: "TEMPERATURE SOURCE";
                                sources: root.temp-sources;
                                current-index <=> root.temp-source-index;
                                sends: root.temp-sends; warn: root.temp-sends-warn;
                                changed(i) => { root.slot-changed(0, i); }
                            }
                            Rectangle { height: 1px; background: Palette.line; }
                            SlotEditor {
                                label: "RPM SOURCE";
                                sources: root.fan-sources;
                                current-index <=> root.fan-source-index;
                                sends: root.fan-sends; warn: root.fan-sends-warn;
                                changed(i) => { root.slot-changed(1, i); }
                            }
                            Rectangle { height: 1px; background: Palette.line; }
                            SlotEditor {
                                label: "USAGE FIELD (%)";
                                sources: root.load-sources;
                                current-index <=> root.load-source-index;
                                sends: root.load-sends; warn: root.load-sends-warn;
                                changed(i) => { root.slot-changed(2, i); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    // right: preview (below the slots when compact)
                    VerticalLayout {
                        row: root.compact ? 1 : 0; col: root.compact ? 0 : 1;
                        min-width: 260px;
                        preferred-width: 320px;
                        horizontal-stretch: 0;
                        spacing: 10px;
                        Text { text: "SCREEN PREVIEW"; color: Palette.muted; font-size: 13px; font-weight: 700; letter-spacing: 0.4px; }
                        Text { text: "COOLER MODEL"; color: Palette.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.4px; }
                        ModelToggle {
                            current: root.model-index;
                            picked(i) => { root.model-index = i; root.model-changed(i); }
                        }
                        DisplayPreview {
                            model: root.model-index;
                            temp: root.prev-temp; load: root.prev-load; fan: root.prev-fan;
                            frame-index: root.prev-frame-index; sending: root.prev-sending;
                        }
                        Text {
                            text: root.model-index == 1
                                ? "Delta V2 preview: the round display shows the temperature and the fan speed. The model can't be detected, so pick yours."
                                : "Alpha preview: round display showing only the temperature. RPM and usage are still sent but not displayed. The model can't be detected, so pick yours.";
                            color: Palette.faint; font-size: 12px; font-weight: 500; wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    }
                }

                // ============ DEVICE ============
                if root.active-page == 2 : VerticalLayout {
                    spacing: 18px;
                    Rectangle {
                        min-height: 128px;
                        background: Palette.surface;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 10px;
                                StatusPill { state: root.conn-state; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: root.device-label; color: Palette.ink; font-size: 16px; font-weight: 800; overflow: elide; }
                            Text { text: root.device-detail; color: Palette.muted; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                            if root.firmware-label != "" : Text { text: root.firmware-label; color: Palette.muted; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                            if root.firmware-hint != "" : Text { text: root.firmware-hint; color: Palette.faint; font-size: 13px; font-weight: 500; wrap: word-wrap; }
                        }
                    }
                    if root.not-elevated : ElevationWarning { }
                    if root.hid-error != "" : Rectangle {
                        min-height: 52px;
                        background: Palette.danger-weak;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Palette.danger.with-alpha(0.3);
                        VerticalLayout {
                            padding: 14px;
                            padding-left: 16px;
                            // Long messages (e.g. the Linux permission fix) wrap.
                            Text { text: root.hid-error; color: Palette.danger; font-size: 13px; font-weight: 600; vertical-alignment: center; wrap: word-wrap; }
                        }
                    }
                    Rectangle {
                        background: Palette.surface;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 6px;
                            Text { text: "How to connect"; color: Palette.ink; font-size: 15px; font-weight: 800; }
                            Text {
                                text: "Plug the watercooler (Kalkan Alpha 240, 360 or 360-W, units purchased from Jan/2026; or Delta V2 240 or 360) into USB and run `kalkan list`: the port marked with ★ is the cooler. Supported firmware: 1.3 (VID/PID 1F3A:0008 or 1A86:484A). The app opens the serial port and starts sending data to the display.";
                                color: Palette.muted; font-size: 13px; font-weight: 500; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // ============ SETTINGS ============
                if root.active-page == 3 : VerticalLayout {
                    spacing: 18px;
                    if root.not-elevated : ElevationWarning { }
                    Rectangle {
                        background: Palette.surface;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "Start with the operating system"; color: Palette.ink; font-size: 15px; font-weight: 800; }
                                    Text {
                                        text: "Starts hidden in the tray when you log in and keeps the display updated. On Windows it uses a scheduled task, so it runs with administrator rights without a UAC prompt.";
                                        color: Palette.muted; font-size: 13px; font-weight: 500; wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        checked <=> root.autostart;
                                        toggled(on) => { root.autostart-toggled(on); }
                                    }
                                }
                            }
                            if root.autostart-error != "" : Text {
                                text: root.autostart-error;
                                color: Palette.danger; font-size: 12px; font-weight: 600; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle {
                        background: Palette.surface;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.line;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 6px;
                            Text { text: "Tray"; color: Palette.ink; font-size: 15px; font-weight: 800; }
                            Text {
                                text: "Closing the window keeps Kalkan Monitor running in the tray. To quit, right-click the tray icon and choose \"Close monitor\".";
                                color: Palette.muted; font-size: 13px; font-weight: 500; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                }
            }
        }
    }
}
