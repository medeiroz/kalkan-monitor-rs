; Kalkan Monitor installer (Windows) - Inno Setup 6.
;
; Generated by `windows/installer/build.ps1`, which builds the app, publishes the
; sidecar and downloads the official PawnIO setup (pinned version, SHA-256
; verified). Do not run ISCC directly without those artifacts.
;
; Installs:
;   * kalkan-monitor.exe  - the dashboard (Rust/Slint), which talks to the cooler;
;   * kalkan-sensord.exe  - sensor sidecar (LibreHardwareMonitor);
;   * PawnIO              - HVCI-compatible kernel driver used by
;                           LibreHardwareMonitor. Installed silently only if
;                           missing or < 2.0 (same rule as LHM). The uninstaller
;                           does NOT remove PawnIO: other programs (e.g.
;                           LibreHardwareMonitor) use the same driver.

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef PawnIOSetup
  #define PawnIOSetup "..\..\target\installer\PawnIO_setup.exe"
#endif

[Setup]
AppId={{6F2A9C4E-3B1D-4E8A-9C57-1D0B8E4F2A63}
AppName=Kalkan Monitor
AppVersion={#AppVersion}
AppPublisher=Kalkan Monitor RS contributors
AppPublisherURL=https://github.com/medeiroz/kalkan-monitor-rs-v1.3
DefaultDirName={autopf}\Kalkan Monitor
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..\..\target\installer
OutputBaseFilename=KalkanMonitor-Setup-{#AppVersion}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\kalkan-monitor.exe
CloseApplications=yes

[Languages]
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "ptbr"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\..\target\release\kalkan-monitor.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\sidecar\kalkan-sensord\bin\Release\net8.0\win-x64\publish\kalkan-sensord.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PawnIOSetup}"; DestDir: "{tmp}"; Flags: deleteafterinstall; Check: PawnIONeeded

[Icons]
Name: "{autoprograms}\Kalkan Monitor"; Filename: "{app}\kalkan-monitor.exe"
Name: "{autodesktop}\Kalkan Monitor"; Filename: "{app}\kalkan-monitor.exe"; Tasks: desktopicon

[Run]
; Old PawnIO (< 2.0): the setup refuses to install over it, so uninstall first.
Filename: "{code:PawnIOUninstaller}"; Parameters: "-uninstall -silent"; StatusMsg: "Updating the PawnIO driver..."; Flags: runhidden waituntilterminated; Check: PawnIOOutdated
Filename: "{tmp}\PawnIO_setup.exe"; Parameters: "-install -silent"; StatusMsg: "Installing the PawnIO driver..."; Flags: runhidden waituntilterminated; Check: PawnIONeeded
Filename: "{app}\kalkan-monitor.exe"; Description: "{cm:LaunchProgram,Kalkan Monitor}"; Flags: nowait postinstall skipifsilent

[Code]
const
  PawnIOKey = 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO';

var
  PawnIOChecked, PawnIOMissing, PawnIOOld: Boolean;

{ Reads the PawnIO state only once: after the old PawnIO is uninstalled the
  registry changes, and the following Checks need to see the original state. }
procedure CheckPawnIO;
var
  Ver: String;
begin
  if PawnIOChecked then
    Exit;
  PawnIOChecked := True;
  if not RegQueryStringValue(HKLM64, PawnIOKey, 'DisplayVersion', Ver) then
  begin
    PawnIOMissing := True;
    Exit;
  end;
  PawnIOOld := StrToIntDef(Copy(Ver, 1, Pos('.', Ver + '.') - 1), 0) < 2;
end;

function PawnIOOutdated: Boolean;
begin
  CheckPawnIO;
  Result := PawnIOOld;
end;

function PawnIONeeded: Boolean;
begin
  CheckPawnIO;
  Result := PawnIOMissing or PawnIOOld;
end;

function PawnIOUninstaller(Param: String): String;
begin
  if not RegQueryStringValue(HKLM64, PawnIOKey, 'InstallLocation', Result) then
    Result := ExpandConstant('{commonpf64}\PawnIO');
  Result := AddBackslash(Result) + 'uninstall.exe';
end;
