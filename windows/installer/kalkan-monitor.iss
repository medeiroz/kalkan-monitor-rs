; Kalkan Monitor installer (Windows) - Inno Setup 6.
;
; Generated by `windows/installer/build.ps1`, which builds the app, publishes the
; sidecar and downloads the official PawnIO setup (pinned version, SHA-256
; verified). Do not run ISCC directly without those artifacts.
;
; Installs:
;   * kalkan-monitor.exe  - the dashboard (Rust/Slint), which talks to the cooler;
;   * kalkan-sensord.exe  - sensor sidecar (LibreHardwareMonitor);
;   * PawnIO              - HVCI-compatible kernel driver used by
;                           LibreHardwareMonitor. Installed silently only if
;                           missing or < 2.0 (same rule as LHM). The uninstaller
;                           does NOT remove PawnIO: other programs (e.g.
;                           LibreHardwareMonitor) use the same driver.

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef PawnIOSetup
  #define PawnIOSetup "..\..\target\installer\PawnIO_setup.exe"
#endif

[Setup]
AppId={{6F2A9C4E-3B1D-4E8A-9C57-1D0B8E4F2A63}
AppName=Kalkan Monitor
AppVersion={#AppVersion}
AppPublisher=Kalkan Monitor RS contributors
AppPublisherURL=https://github.com/medeiroz/kalkan-monitor-rs-v1.3
DefaultDirName={autopf}\Kalkan Monitor
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..\..\target\installer
OutputBaseFilename=KalkanMonitor-Setup-{#AppVersion}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\kalkan-monitor.exe
CloseApplications=yes

[Languages]
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "ptbr"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

[CustomMessages]
en.PawnIOUpdating=Updating the PawnIO sensor driver...
en.PawnIOInstalling=Installing the PawnIO sensor driver...
en.PawnIOPageCaption=PawnIO sensor driver
en.PawnIOPageDesc=Kalkan Monitor needs this driver to read CPU temperature and fan speed.
en.PawnIOPageText=PawnIO is a signed kernel driver, compatible with Windows Memory Integrity (HVCI). Kalkan Monitor uses it to read the CPU temperature and fan sensors.%n%nIt comes from https://pawnio.eu and will be installed (or updated) together with Kalkan Monitor.%n%nPawnIO stays installed if you uninstall Kalkan Monitor, because other tools, such as LibreHardwareMonitor, may use it.
en.PawnIOReadyInstall=PawnIO sensor driver (from https://pawnio.eu) will be installed. It stays installed when Kalkan Monitor is uninstalled.
en.PawnIOReadyUpdate=PawnIO sensor driver (from https://pawnio.eu) will be updated. It stays installed when Kalkan Monitor is uninstalled.
ptbr.PawnIOUpdating=Atualizando o driver de sensores PawnIO...
ptbr.PawnIOInstalling=Instalando o driver de sensores PawnIO...
ptbr.PawnIOPageCaption=Driver de sensores PawnIO
ptbr.PawnIOPageDesc=O Kalkan Monitor precisa deste driver para ler a temperatura da CPU e a velocidade das ventoinhas.
ptbr.PawnIOPageText=O PawnIO é um driver de kernel assinado, compatível com a Integridade de Memória do Windows (HVCI). O Kalkan Monitor o usa para ler os sensores de temperatura da CPU e de ventoinhas.%n%nEle vem de https://pawnio.eu e será instalado (ou atualizado) junto com o Kalkan Monitor.%n%nO PawnIO continua instalado se você desinstalar o Kalkan Monitor, pois outras ferramentas, como o LibreHardwareMonitor, podem usá-lo.
ptbr.PawnIOReadyInstall=O driver de sensores PawnIO (de https://pawnio.eu) será instalado. Ele continua instalado quando o Kalkan Monitor for desinstalado.
ptbr.PawnIOReadyUpdate=O driver de sensores PawnIO (de https://pawnio.eu) será atualizado. Ele continua instalado quando o Kalkan Monitor for desinstalado.

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\..\target\release\kalkan-monitor.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\sidecar\kalkan-sensord\bin\Release\net8.0\win-x64\publish\kalkan-sensord.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PawnIOSetup}"; DestDir: "{tmp}"; Flags: deleteafterinstall; Check: PawnIONeeded

[Icons]
Name: "{autoprograms}\Kalkan Monitor"; Filename: "{app}\kalkan-monitor.exe"
Name: "{autodesktop}\Kalkan Monitor"; Filename: "{app}\kalkan-monitor.exe"; Tasks: desktopicon

[Run]
; Old PawnIO (< 2.0): the setup refuses to install over it, so uninstall first.
Filename: "{code:PawnIOUninstaller}"; Parameters: "-uninstall -silent"; StatusMsg: "{cm:PawnIOUpdating}"; Flags: runhidden waituntilterminated; Check: PawnIOOutdated
Filename: "{tmp}\PawnIO_setup.exe"; Parameters: "-install -silent"; StatusMsg: "{cm:PawnIOInstalling}"; Flags: runhidden waituntilterminated; Check: PawnIONeeded
Filename: "{app}\kalkan-monitor.exe"; Description: "{cm:LaunchProgram,Kalkan Monitor}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
; The app may be running hidden in the tray; stop it (and its sensor sidecar)
; so its files can be removed, then drop the "start with Windows" task.
Filename: "{sys}\taskkill.exe"; Parameters: "/F /IM kalkan-monitor.exe"; Flags: runhidden waituntilterminated; RunOnceId: "KillApp"
Filename: "{sys}\taskkill.exe"; Parameters: "/F /IM kalkan-sensord.exe"; Flags: runhidden waituntilterminated; RunOnceId: "KillSidecar"
Filename: "{sys}\schtasks.exe"; Parameters: "/Delete /TN ""Kalkan Monitor"" /F"; Flags: runhidden waituntilterminated; RunOnceId: "DeleteTask"

[Code]
const
  PawnIOKey = 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO';

var
  PawnIOChecked, PawnIOMissing, PawnIOOld: Boolean;

{ Reads the PawnIO state only once: after the old PawnIO is uninstalled the
  registry changes, and the following Checks need to see the original state. }
procedure CheckPawnIO;
var
  Ver: String;
begin
  if PawnIOChecked then
    Exit;
  PawnIOChecked := True;
  if not RegQueryStringValue(HKLM64, PawnIOKey, 'DisplayVersion', Ver) then
  begin
    PawnIOMissing := True;
    Exit;
  end;
  PawnIOOld := StrToIntDef(Copy(Ver, 1, Pos('.', Ver + '.') - 1), 0) < 2;
end;

function PawnIOOutdated: Boolean;
begin
  CheckPawnIO;
  Result := PawnIOOld;
end;

function PawnIONeeded: Boolean;
begin
  CheckPawnIO;
  Result := PawnIOMissing or PawnIOOld;
end;

function PawnIOUninstaller(Param: String): String;
begin
  if not RegQueryStringValue(HKLM64, PawnIOKey, 'InstallLocation', Result) then
    Result := ExpandConstant('{commonpf64}\PawnIO');
  Result := AddBackslash(Result) + 'uninstall.exe';
end;

var
  PawnIOPage: TOutputMsgWizardPage;

{ Tells the user about the PawnIO driver before "Ready to Install", only when
  it is going to be installed or updated. }
procedure InitializeWizard;
begin
  if PawnIONeeded then
    PawnIOPage := CreateOutputMsgPage(wpSelectTasks,
      ExpandConstant('{cm:PawnIOPageCaption}'),
      ExpandConstant('{cm:PawnIOPageDesc}'),
      ExpandConstant('{cm:PawnIOPageText}'));
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo,
  MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
begin
  Result := MemoDirInfo;
  if MemoGroupInfo <> '' then
    Result := Result + NewLine + NewLine + MemoGroupInfo;
  if MemoTasksInfo <> '' then
    Result := Result + NewLine + NewLine + MemoTasksInfo;
  if PawnIONeeded then
  begin
    if PawnIOOutdated then
      Result := Result + NewLine + NewLine + ExpandConstant('{cm:PawnIOReadyUpdate}')
    else
      Result := Result + NewLine + NewLine + ExpandConstant('{cm:PawnIOReadyInstall}');
  end;
end;

{ An update may find the app running hidden in the tray (elevated, so the
  Restart Manager may not close it): stop it and its sidecar before copying. }
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Code: Integer;
begin
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM kalkan-monitor.exe', '', SW_HIDE, ewWaitUntilTerminated, Code);
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM kalkan-sensord.exe', '', SW_HIDE, ewWaitUntilTerminated, Code);
  Result := '';
end;
