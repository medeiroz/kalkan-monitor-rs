<Project Sdk="Microsoft.NET.Sdk">

  <!--
    kalkan-sensord — Windows sensor sidecar.

    Loads LibreHardwareMonitor (which in turn extracts and loads its own kernel
    driver) and emits temperature/fan readings as one JSON line per second on
    stdout. The Rust process (kalkan-core, Windows only) spawns this executable
    and reads its output. Published self-contained win-x64, so it does NOT require
    .NET to be installed on the user's machine.

    Only built/packaged in the Windows artifact; macOS/Linux use native sources
    (hwmon / SMC) and do not need this sidecar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>kalkan-sensord</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>

    <!--
      Memory footprint: this is a tiny 1 Hz loop, so favour a small heap over
      throughput. Workstation, non-concurrent GC (no background GC thread/heap),
      no dynamic PGO instrumentation, and resource-key exception messages.
      NO trimming: LibreHardwareMonitor relies on reflection.
    -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0-9: higher compacts more eagerly to keep the heap small. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

  <ItemGroup>
    <!-- LibreHardwareMonitor (MPL-2.0). Ships the signed kernel driver. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.*" />
  </ItemGroup>

</Project>
