<Project Sdk="Microsoft.NET.Sdk">

  <!--
    kalkan-sensord — sidecar de sensores do Windows.

    Carrega o LibreHardwareMonitor (que, por sua vez, extrai e carrega o próprio
    driver de kernel) e emite leituras de temperatura/fan como JSON por linha no
    stdout, a cada 1 s. O processo Rust (kalkan-core, só no Windows) spawna este
    executável e lê a saída. Publicado self-contained win-x64, então NÃO exige
    .NET instalado na máquina do usuário.

    Só é compilado/empacotado no artefato do Windows; macOS/Linux usam fontes
    nativas (hwmon / SMC) e não precisam deste sidecar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>kalkan-sensord</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- LibreHardwareMonitor (MPL-2.0). Traz o driver de kernel assinado. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.*" />
  </ItemGroup>

</Project>
