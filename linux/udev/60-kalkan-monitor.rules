# Kalkan Alpha 240 / 360 / 360-W and Delta V2 240 / 360 watercooler display (SmartMonitor 1.3) (USB serial, /dev/ttyUSB* or /dev/ttyACM*).
#
# TAG+="uaccess" gives the user logged in at the machine access to the port.
# MODE/GROUP is the fallback for sessions without a seat (SSH, minimal setups):
# members of "dialout" can open it.
# The file is named 60-* so the uaccess tag is set before 70-uaccess.rules runs.

SUBSYSTEM=="tty", ATTRS{idVendor}=="1f3a", ATTRS{idProduct}=="0008", TAG+="uaccess", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="484a", TAG+="uaccess", MODE="0660", GROUP="dialout"
