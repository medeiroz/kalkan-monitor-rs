# Kalkan watercooler displays: Alpha 240 / 360 / 360-W and Delta V2 240 / 360.
#
# TAG+="uaccess" gives the user logged in at the machine access to the device.
# The file is named 60-* so the uaccess tag is set before 70-uaccess.rules runs.

# --- firmware 1.3 (USB serial) -----------------------------------------------
# Alpha Rev.2 (from Jan/2026) and Delta V2 (SmartMonitor 1.3), /dev/ttyUSB* or
# /dev/ttyACM*. MODE/GROUP is the fallback for sessions without a seat (SSH,
# minimal setups): members of "dialout" can open it.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1f3a", ATTRS{idProduct}=="0008", TAG+="uaccess", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="484a", TAG+="uaccess", MODE="0660", GROUP="dialout"

# --- firmware 1.2 (HID) ------------------------------------------------------
# Alpha Rev.1 (sold before Jan/2026, SmartMonitor 1.2; experimental), /dev/hidraw*.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="1100", TAG+="uaccess"
